# Sarvam AI API Key (required)
# Get yours at: https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_your_key_here

# Optional: For using OpenAI as LLM provider
# OPENAI_API_KEY=sk-your-openai-key

# Optional: For using Groq as LLM provider
# GROQ_API_KEY=gsk_your-groq-key

# Optional: Custom LLM base URL (for self-hosted or other providers)
# LLM_BASE_URL=https://api.groq.com/openai/v1
